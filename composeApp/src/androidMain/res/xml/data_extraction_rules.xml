<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de Android 12 y posteriores. Igual que en backup_rules.xml: al
    declarar un <include>, lo que no se nombra queda excluido, de modo que solo
    viajan las preferencias. Los documentos del usuario nunca salen del telefono.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
